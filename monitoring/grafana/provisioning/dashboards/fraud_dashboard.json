{
  "uid": "fraud-detection",
  "title": "Fraud Detection Real-Time Monitoring",
  "description": "Real-time Fraud Detection Monitoring + Drift",
  "tags": ["fraud-detection", "real-time", "monitoring"],
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "",
  "schemaVersion": 38,
  "version": 3,
  "panels": [
    { "id": 1, "type": "row", "title": "SYSTEM OVERVIEW", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2, "title": "Transactions Per Second", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 50 }, { "color": "green", "value": 70 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [{ "expr": "sum(rate(producer_transactions_sent_total[1m]))", "refId": "A" }]
    },
    {
      "id": 3, "title": "Current Fraud Rate (last batch)", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "targets": [{ "expr": "sum(increase(spark_fraud_detected_total[5m])) / sum(increase(spark_transactions_processed_total[5m])) * 100", "refId": "A" }]
    },
    {
      "id": 4, "title": "Transaction Throughput (produced vs processed)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "expr": "rate(producer_transactions_sent_total[2m])", "legendFormat": "Produced", "refId": "A" },
        { "expr": "rate(spark_transactions_processed_total[2m])", "legendFormat": "Processed", "refId": "B" }
      ]
    },
    { "id": 5, "type": "row", "title": "FRAUD DETECTION METRICS", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    {
      "id": 6, "title": "Fraud Detection Rate (detected vs ground truth)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2 } },
      "targets": [
        { "expr": "sum(increase(spark_fraud_detected_total[5m])) / sum(increase(spark_transactions_processed_total[5m])) * 100", "legendFormat": "Fraud Detected (model)", "refId": "A" },
        { "expr": "sum(increase(producer_fraud_sent_total[5m])) / sum(increase(producer_transactions_sent_total[5m])) * 100", "legendFormat": "Actual Fraud (ground truth)", "refId": "B" }
      ]
    },
    {
      "id": 7, "title": "Batch Compute Latency", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(spark_inference_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum(rate(spark_inference_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50", "refId": "B" }
      ]
    },
    {
      "id": 8, "title": "Batch Processing Statistics", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        { "expr": "rate(spark_batch_size_transactions_sum[2m]) / rate(spark_batch_size_transactions_count[2m])", "legendFormat": "avg batch size", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(spark_batch_processing_time_seconds_bucket[5m])) by (le))", "legendFormat": "P95 batch time", "refId": "B" }
      ]
    },
    {
      "id": 9, "title": "Fraud Score Distribution (last 5m)", "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        { "expr": "sum(increase(spark_fraud_score_distribution_bucket{le=\"0.1\"}[5m]))", "legendFormat": "0.0-0.1", "refId": "A" },
        { "expr": "sum(increase(spark_fraud_score_distribution_bucket{le=\"1.0\"}[5m])) - sum(increase(spark_fraud_score_distribution_bucket{le=\"0.9\"}[5m]))", "legendFormat": "0.9-1.0", "refId": "J" }
      ]
    },
    { "id": 10, "type": "row", "title": "MODEL DRIFT MONITORING", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 } },
    {
      "id": 11, "title": "PSI per Feature (Current vs Training Reference)", "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.25 }] } }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [{ "expr": "drift_psi", "legendFormat": "{{feature}}", "refId": "A" }]
    },
    {
      "id": 12, "title": "Max PSI Over Time (threshold 0.25)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.25 }] }, "custom": { "thresholdsStyle": { "mode": "line" } } } },
      "targets": [
        { "expr": "drift_max_psi", "legendFormat": "max PSI", "refId": "A" },
        { "expr": "vector(0.25)", "legendFormat": "threshold 0.25", "refId": "B" }
      ]
    },
    {
      "id": 13, "title": "Drifted Features (PSI > 0.25)", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }] } } },
      "targets": [{ "expr": "drift_features_drifted", "refId": "A" }]
    },
    {
      "id": 14, "title": "Score Drift PSI", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 35 },
      "fieldConfig": { "defaults": { "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.25 }] } } },
      "targets": [{ "expr": "drift_score_psi", "refId": "A" }]
    },
    {
      "id": 15, "title": "Drift Window Size", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 35 },
      "targets": [{ "expr": "drift_window_size", "refId": "A" }]
    },
    {
      "id": 16, "title": "Drift Injection Active", "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 35 },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "OFF" }, "1": { "text": "ON" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [{ "expr": "producer_drift_injection_active", "refId": "A" }]
    },

        { "id": 17, "type": "row", "title": "EXPLAINABILITY (SHAP)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 } },
    {
      "id": 18, "title": "SHAP Explanations Total", "type": "stat",
      "datasource": { "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 44 },
      "targets": [{ "expr": "spark_shap_explanations_total", "refId": "A" }]
    },
    {
      "id": 19, "title": "SHAP Rate", "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 44 },
      "targets": [{ "expr": "rate(spark_shap_explanations_total[5m])", "refId": "A" }]
    },
    {
      "id": 20, "title": "SHAP Latency P95", "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(spark_shap_duration_seconds_bucket[5m])) by (le))", "refId": "A" }]
    }
  ]
}